{
  "name": "movehat",
  "version": "0.3.0",
  "type": "module",
  "description": "Hardhat-like development framework for Movement L1 smart contracts",
  "bin": {
    "movehat": "./bin/movehat.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "import": "./dist/helpers/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc && npm run copy-templates",
    "copy-templates": "cp -r src/templates dist/",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "check-pack-contents": "node scripts/check-pack-contents.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "docs:api": "typedoc && node scripts/postprocess-typedoc.mjs",
    "bench": "cd ../../examples/counter-example && tsx ../../packages/movehat/bench/fork.bench.ts",
    "prepack": "cp ../../README.md README.md",
    "prepublishOnly": "npm run build && npm run check-pack-contents"
  },
  "files": [
    "dist",
    "bin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gilbertsahumada/movehat.git"
  },
  "homepage": "https://github.com/gilbertsahumada/movehat#readme",
  "bugs": {
    "url": "https://github.com/gilbertsahumada/movehat/issues"
  },
  "keywords": [
    "move",
    "movement",
    "blockchain",
    "smart-contracts",
    "hardhat",
    "framework",
    "web3",
    "dapp"
  ],
  "author": "Gilberts Ahumada",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^5.1.5",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "figures": "^6.1.0",
    "js-yaml": "^4.1.1",
    "ora": "^9.0.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "tsx": "^4.7.0"
  },
  "optionalDependencies": {
    "movelite": "^0.2.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "^4.0.16",
    "memfs": "^4.51.1",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
