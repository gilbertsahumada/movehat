{
  "name": "{{projectName}}",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "compile": "movehat compile",
    "lint": "movehat lint",
    "prove": "movehat prove",
    "test": "movehat test",
    "test:coverage": "movehat test --coverage",
    "test:move": "movehat test:move",
    "test:ts": "movehat test:ts",
    "test:watch": "movehat test:ts --watch",
    "typecheck": "tsc --noEmit",
    "deploy": "movehat run scripts/deploy-counter.ts"
  },
  "dependencies": {
    "movehat": "{{movehatVersion}}",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "chai": "^6.2.1",
    "mocha": "^11.7.5",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  }
}
