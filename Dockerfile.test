# Dockerfile para testing de MoveHat
# Simula instalación limpia en diferentes versiones de Node.js
# 
# Build:
#   docker build -f Dockerfile.test --build-arg NODE_VERSION=20 -t movehat-test .
#
# Run:
#   docker run --rm movehat-test ./scripts/e2e-local.sh --quick

ARG NODE_VERSION=20
FROM node:${NODE_VERSION}-bookworm

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    build-essential \
    ca-certificates \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install the same verified Movement CLI artifact used in CI. A failed
# download, checksum mismatch, or unusable binary must fail the image build;
# tests are never allowed to pass against a mock CLI.
ARG MOVEMENT_CLI_SHA256=f2bdf3fa82e6b49c83c91be0967640282e1759e66b237440709a8779a9f9c1b2
RUN curl -fL -o /tmp/movement-cli.tar.gz \
      https://github.com/movementlabsxyz/homebrew-movement-cli/releases/download/bypass-homebrew/movement-cli-l1-linux-x86_64.tar.gz \
    && echo "${MOVEMENT_CLI_SHA256}  /tmp/movement-cli.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/movement-cli.tar.gz -C /usr/local/bin movement \
    && chmod 0755 /usr/local/bin/movement \
    && rm /tmp/movement-cli.tar.gz \
    && movement --version

# Install pnpm
RUN npm install -g pnpm@9

# Set working directory
WORKDIR /app

# Copy package files first (for better caching)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/movehat/package.json ./packages/movehat/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy the rest of the project
COPY . .

# Build the project
RUN pnpm build:movehat

# Set environment for testing
ENV NODE_ENV=test
ENV CI=true

# Default command: run E2E tests
CMD ["./scripts/e2e-local.sh", "--quick"]
